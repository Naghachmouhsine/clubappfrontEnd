# 🔧 Configuration d'Environnement - Royal Tennis Club de Fès Frontend
# Copiez ce fichier vers .env et configurez vos valeurs

# =============================================================================
# 🌍 CONFIGURATION GÉNÉRALE
# =============================================================================

# Environnement (development, staging, production)
NODE_ENV=development

# Nom de l'application
APP_NAME="Royal Tennis Club de Fès"

# Version de l'application
APP_VERSION=2.1.0

# URL de base de l'application
APP_URL=http://localhost:4200

# =============================================================================
# 🔗 API ET BACKEND
# =============================================================================

# URL de l'API backend
API_URL=http://localhost:3000/api

# Timeout des requêtes API (en millisecondes)
API_TIMEOUT=30000

# Clé API (si nécessaire)
API_KEY=your-api-key-here

# =============================================================================
# 💳 PAIEMENTS STRIPE
# =============================================================================

# Clé publique Stripe (développement)
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here

# Devise par défaut
STRIPE_CURRENCY=MAD

# =============================================================================
# 🔥 FIREBASE (OPTIONNEL)
# =============================================================================

# Configuration Firebase pour les notifications push
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef123456

# =============================================================================
# 📊 ANALYTICS ET MONITORING
# =============================================================================

# Google Analytics Measurement ID
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry DSN pour le monitoring des erreurs
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# =============================================================================
# 🔐 SÉCURITÉ
# =============================================================================

# Clé de chiffrement pour les données sensibles
ENCRYPTION_KEY=your-32-character-encryption-key

# Salt pour le hachage
HASH_SALT=your-random-salt-here

# =============================================================================
# 📧 EMAIL ET NOTIFICATIONS
# =============================================================================

# Configuration email (pour les notifications)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Webhook Slack pour les notifications (optionnel)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# =============================================================================
# 🗺️ CARTES ET GÉOLOCALISATION
# =============================================================================

# Clé API Google Maps (si utilisée)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# =============================================================================
# 📱 CONFIGURATION MOBILE
# =============================================================================

# App ID pour les stores
IOS_APP_ID=ma.royaltennisclub.fes
ANDROID_PACKAGE_NAME=ma.royaltennisclub.fes

# Deep linking
DEEP_LINK_SCHEME=royaltennisclub

# =============================================================================
# 🔧 DÉVELOPPEMENT
# =============================================================================

# Port de développement
DEV_PORT=4200

# Activer le mode debug
DEBUG_MODE=true

# Activer les logs détaillés
VERBOSE_LOGGING=true

# Activer le hot reload
HOT_RELOAD=true

# =============================================================================
# 🚀 DÉPLOIEMENT
# =============================================================================

# URL de production
PROD_URL=https://app.royaltennisclub-fes.ma

# URL de staging
STAGING_URL=https://staging.royaltennisclub-fes.ma

# CDN pour les assets statiques (optionnel)
CDN_URL=https://cdn.royaltennisclub-fes.ma

# =============================================================================
# 📊 MÉTRIQUES ET PERFORMANCE
# =============================================================================

# Activer les métriques de performance
ENABLE_PERFORMANCE_METRICS=true

# Activer le tracking des erreurs
ENABLE_ERROR_TRACKING=true

# Activer les analytics
ENABLE_ANALYTICS=true

# =============================================================================
# 🌐 INTERNATIONALISATION
# =============================================================================

# Langue par défaut
DEFAULT_LANGUAGE=fr

# Langues supportées (séparées par des virgules)
SUPPORTED_LANGUAGES=fr,en,ar

# =============================================================================
# 🔄 CACHE ET STOCKAGE
# =============================================================================

# Durée de cache par défaut (en secondes)
CACHE_DURATION=3600

# Taille maximale du cache local (en MB)
MAX_CACHE_SIZE=50

# =============================================================================
# 🎨 THÈME ET APPARENCE
# =============================================================================

# Thème par défaut (light, dark, auto)
DEFAULT_THEME=auto

# Couleur primaire
PRIMARY_COLOR=#d4af37

# Couleur secondaire
SECONDARY_COLOR=#1a1a1a

# =============================================================================
# 📞 SUPPORT ET CONTACT
# =============================================================================

# Email de support
SUPPORT_EMAIL=support@royaltennisclub-fes.ma

# Téléphone de support
SUPPORT_PHONE=+212 5XX XX XX XX

# URL du site web principal
WEBSITE_URL=https://www.royaltennisclub-fes.ma

# =============================================================================
# 🔒 NOTES DE SÉCURITÉ
# =============================================================================

# ⚠️  IMPORTANT : 
# - Ne jamais commiter le fichier .env dans Git
# - Utilisez des valeurs différentes pour chaque environnement
# - Gardez les clés secrètes en sécurité
# - Changez régulièrement les mots de passe et clés API
# - Utilisez des clés de test en développement

# =============================================================================
# 📝 EXEMPLE D'UTILISATION
# =============================================================================

# Dans votre code TypeScript :
# import { environment } from '../environments/environment';
# 
# const apiUrl = environment.apiUrl;
# const stripeKey = environment.stripe.publicKey;

# =============================================================================
# 🔗 LIENS UTILES
# =============================================================================

# Documentation Stripe : https://stripe.com/docs
# Documentation Firebase : https://firebase.google.com/docs
# Documentation Sentry : https://docs.sentry.io/
# Documentation Google Analytics : https://developers.google.com/analytics